{
    "name": "appmixer.deepl.core.ListLanguages",
    "label": "List Languages",
    "description": "Languages of a DeepL feature, as options of a language field.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": true,
    "auth": {
        "service": "appmixer:deepl"
    },
    "quota": {
        "manager": "appmixer:deepl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "resource": {
                        "type": "string"
                    },
                    "usableAs": {
                        "type": "string"
                    }
                }
            },
            "inspector": {
                "inputs": {
                    "resource": {
                        "type": "text",
                        "index": 1,
                        "label": "Feature"
                    },
                    "usableAs": {
                        "type": "text",
                        "index": 2,
                        "label": "Usable As"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "languages": {
                        "type": "array",
                        "title": "Languages",
                        "items": {
                            "type": "object",
                            "properties": {
                                "lang": {
                                    "type": "string",
                                    "title": "Code",
                                    "example": "de"
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "German"
                                }
                            }
                        },
                        "example": [
                            {
                                "lang": "de",
                                "name": "German"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
