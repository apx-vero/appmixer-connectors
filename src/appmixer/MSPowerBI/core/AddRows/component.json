{
    "name": "appmixer.MSPowerBI.core.AddRows",
    "author": "Appmixer",
    "description": "Adds new data rows to the specified table in a push dataset. Used for streaming/real-time data scenarios.",
    "private": false,
    "icon": "data:image/svg+xml;base64,",
    "auth": {
        "service": "appmixer:MSPowerBI",
        "scope": [
            "https://analysis.windows.net/powerbi/api/Dataset.ReadWrite.All"
        ]
    },
    "quota": {
        "manager": "appmixer:MSPowerBI:core",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "datasetId": {
                        "type": "string"
                    },
                    "tableName": {
                        "type": "string"
                    },
                    "rows": {
                        "type": "string",
                        "description": "JSON array of row objects to add."
                    }
                },
                "required": [
                    "datasetId",
                    "tableName",
                    "rows"
                ]
            },
            "inspector": {
                "inputs": {
                    "datasetId": {
                        "type": "text",
                        "group": "config",
                        "label": "Dataset ID",
                        "index": 1,
                        "tooltip": "The ID of the push dataset."
                    },
                    "tableName": {
                        "type": "text",
                        "group": "config",
                        "label": "Table Name",
                        "index": 2,
                        "tooltip": "The name of the table to add rows to."
                    },
                    "rows": {
                        "type": "textarea",
                        "group": "config",
                        "label": "Rows (JSON Array)",
                        "index": 3,
                        "tooltip": "A JSON array of row objects. Example: [{\"ProductID\":1,\"Name\":\"Widget\"}]"
                    }
                },
                "groups": {
                    "config": {
                        "label": "Configuration",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Status",
                    "value": "status"
                },
                {
                    "label": "Dataset ID",
                    "value": "datasetId"
                },
                {
                    "label": "Table Name",
                    "value": "tableName"
                },
                {
                    "label": "Rows Added",
                    "value": "rowsAdded"
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "groupId": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "groupId": {
                    "type": "text",
                    "group": "config",
                    "label": "Workspace (Group) ID",
                    "index": 4,
                    "tooltip": "Optional. The workspace (group) ID. If omitted, My Workspace is used.",
                    "required": false
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}