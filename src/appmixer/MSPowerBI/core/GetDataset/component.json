{
    "name": "appmixer.MSPowerBI.core.GetDataset",
    "author": "Appmixer",
    "description": "Returns the specified dataset from My Workspace or a specified group/workspace.",
    "private": false,
    "icon": "data:image/svg+xml;base64,",
    "auth": {
        "service": "appmixer:MSPowerBI",
        "scope": [
            "Dataset.Read.All"
        ]
    },
    "quota": {
        "manager": "appmixer:MSPowerBI:core",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "datasetId": {
                        "type": "string"
                    }
                },
                "required": [
                    "datasetId"
                ]
            },
            "inspector": {
                "inputs": {
                    "datasetId": {
                        "type": "text",
                        "group": "config",
                        "label": "Dataset ID",
                        "index": 1,
                        "tooltip": "The ID of the dataset to retrieve."
                    }
                },
                "groups": {
                    "config": {
                        "label": "Configuration",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Dataset ID",
                    "value": "id"
                },
                {
                    "label": "Name",
                    "value": "name"
                },
                {
                    "label": "Add Rows API Enabled",
                    "value": "addRowsAPIEnabled"
                },
                {
                    "label": "Configured By",
                    "value": "configuredBy"
                },
                {
                    "label": "Is Refreshable",
                    "value": "isRefreshable"
                },
                {
                    "label": "Is Effective Identity Required",
                    "value": "isEffectiveIdentityRequired"
                },
                {
                    "label": "Is Effective Identity Roles Required",
                    "value": "isEffectiveIdentityRolesRequired"
                },
                {
                    "label": "Is On Premises",
                    "value": "isOnPremGatewayRequired"
                },
                {
                    "label": "Target Storage Mode",
                    "value": "targetStorageMode"
                },
                {
                    "label": "Created Date",
                    "value": "createdDate"
                },
                {
                    "label": "Content Provider Type",
                    "value": "contentProviderType"
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "groupId": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "groupId": {
                    "type": "text",
                    "group": "config",
                    "label": "Workspace (Group) ID",
                    "index": 2,
                    "tooltip": "Optional. The workspace (group) ID. If omitted, My Workspace is used.",
                    "required": false
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}