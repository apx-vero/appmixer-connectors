{
    "name": "appmixer.MSPowerBI.core.ListDashboards",
    "author": "Appmixer",
    "description": "Returns a list of dashboards from My Workspace or a specified group/workspace.",
    "private": false,
    "icon": "data:image/svg+xml;base64,",
    "auth": {
        "service": "appmixer:MSPowerBI",
        "scope": [
            "https://analysis.windows.net/powerbi/api/Dashboard.Read.All"
        ]
    },
    "quota": {
        "manager": "appmixer:MSPowerBI:core",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {}
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Dashboards",
                    "value": "dashboards"
                },
                {
                    "label": "Dashboard Count",
                    "value": "count"
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "groupId": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "groupId": {
                    "type": "text",
                    "group": "config",
                    "label": "Workspace (Group) ID",
                    "index": 1,
                    "tooltip": "Optional. The workspace (group) ID. If omitted, dashboards from My Workspace are returned.",
                    "required": false
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}