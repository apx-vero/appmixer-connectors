{
    "name": "appmixer.deepl.core.UpdateGlossary",
    "label": "Update Glossary",
    "description": "Rename a DeepL glossary, add entries to the dictionary of a language pair, or both. Entries are merged into the dictionary: a source term that already exists gets the new target term. To replace a whole dictionary, use Replace Glossary Dictionary.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:deepl"
    },
    "quota": {
        "manager": "appmixer:deepl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "glossaryId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "sourceLang": {
                        "type": "string"
                    },
                    "targetLang": {
                        "type": "string"
                    },
                    "entries": {
                        "type": "string"
                    },
                    "entriesFormat": {
                        "type": "string",
                        "enum": [
                            "tsv",
                            "csv"
                        ]
                    }
                },
                "required": [
                    "glossaryId"
                ]
            },
            "inspector": {
                "inputs": {
                    "glossaryId": {
                        "type": "text",
                        "index": 1,
                        "label": "Glossary",
                        "tooltip": "Pick a glossary, or type the glossary ID.",
                        "source": {
                            "url": "/component/appmixer/deepl/core/ListGlossaries?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListGlossaries#toSelectArray"
                            }
                        }
                    },
                    "name": {
                        "type": "text",
                        "index": 2,
                        "label": "Name",
                        "tooltip": "The new name. Leave empty to keep it."
                    },
                    "sourceLang": {
                        "type": "text",
                        "index": 3,
                        "label": "Source Language",
                        "tooltip": "The language of the source terms. Two-letter language code, for example <code>en</code>. Pick one, or type the code.",
                        "source": {
                            "url": "/component/appmixer/deepl/core/ListLanguages?outPort=out",
                            "data": {
                                "messages": {
                                    "in/resource": "glossary",
                                    "in/usableAs": "source"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListLanguages#toSelectArray"
                            }
                        }
                    },
                    "targetLang": {
                        "type": "text",
                        "index": 4,
                        "label": "Target Language",
                        "tooltip": "The language of the target terms, for example <code>de</code>. Pick one, or type the code.",
                        "source": {
                            "url": "/component/appmixer/deepl/core/ListLanguages?outPort=out",
                            "data": {
                                "messages": {
                                    "in/resource": "glossary",
                                    "in/usableAs": "target"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListLanguages#toSelectArray"
                            }
                        }
                    },
                    "entries": {
                        "type": "textarea",
                        "index": 5,
                        "label": "Entries",
                        "tooltip": "One entry per line: the source term, a tab and the target term (TSV), or the two terms separated by a comma (CSV). <code>\\t</code> is accepted for a tab. Leave empty to change only the name; with entries, set the source and target language too."
                    },
                    "entriesFormat": {
                        "type": "select",
                        "index": 6,
                        "label": "Entries Format",
                        "defaultValue": "tsv",
                        "tooltip": "The format of the entries.",
                        "options": [
                            {
                                "label": "Tab-separated (TSV)",
                                "value": "tsv"
                            },
                            {
                                "label": "Comma-separated (CSV)",
                                "value": "csv"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
