{
    "name": "appmixer.MSPowerBI.core.ExecuteQueries",
    "author": "Appmixer",
    "description": "Executes DAX queries against the specified dataset and returns the results.",
    "private": false,
    "icon": "data:image/svg+xml;base64,",
    "auth": {
        "service": "appmixer:MSPowerBI",
        "scope": [
            "https://analysis.windows.net/powerbi/api/Dataset.Read.All"
        ]
    },
    "quota": {
        "manager": "appmixer:MSPowerBI:core",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "datasetId": {
                        "type": "string"
                    },
                    "query": {
                        "type": "string"
                    },
                    "impersonatedUserName": {
                        "type": "string"
                    }
                },
                "required": [
                    "datasetId",
                    "query"
                ]
            },
            "inspector": {
                "inputs": {
                    "datasetId": {
                        "type": "text",
                        "group": "config",
                        "label": "Dataset ID",
                        "index": 1,
                        "tooltip": "The ID of the dataset to query."
                    },
                    "query": {
                        "type": "textarea",
                        "group": "config",
                        "label": "DAX Query",
                        "index": 2,
                        "tooltip": "A DAX query to execute against the dataset. Example: EVALUATE SUMMARIZE('Sales', 'Sales'[Year])"
                    },
                    "impersonatedUserName": {
                        "type": "text",
                        "group": "config",
                        "label": "Impersonated User (UPN)",
                        "index": 3,
                        "tooltip": "Optional. The UPN of a user to impersonate when executing the query (for RLS scenarios).",
                        "required": false
                    }
                },
                "groups": {
                    "config": {
                        "label": "Configuration",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Results",
                    "value": "results"
                },
                {
                    "label": "Tables",
                    "value": "tables"
                },
                {
                    "label": "Error",
                    "value": "error"
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "groupId": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "groupId": {
                    "type": "text",
                    "group": "config",
                    "label": "Workspace (Group) ID",
                    "index": 4,
                    "tooltip": "Optional. The workspace (group) ID. If omitted, My Workspace is used.",
                    "required": false
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}