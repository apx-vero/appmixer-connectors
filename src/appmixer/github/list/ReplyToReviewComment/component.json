{
    "name": "appmixer.github.list.ReplyToReviewComment",
    "label": "Reply To Review Comment",
    "description": "Reply to an existing pull request review comment, inside its review thread.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "public_repo",
            "repo"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "repositoryId": {
                        "type": "string",
                        "pattern": "[^/]+[/][^/]+"
                    },
                    "pullRequestNumber": {
                        "type": "string"
                    },
                    "commentId": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    }
                },
                "required": [
                    "repositoryId",
                    "pullRequestNumber",
                    "commentId",
                    "body"
                ]
            },
            "inspector": {
                "inputs": {
                    "repositoryId": {
                        "type": "text",
                        "group": "config",
                        "label": "Repository",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                            "data": {
                                "transform": "./transformers#reposToSelectArray"
                            }
                        },
                        "tooltip": "The repository the pull request lives in, in the 'owner/repo' form."
                    },
                    "pullRequestNumber": {
                        "type": "text",
                        "label": "Pull Request Number",
                        "index": 2,
                        "tooltip": "The number of the pull request the comment belongs to."
                    },
                    "commentId": {
                        "type": "text",
                        "label": "Comment ID",
                        "index": 3,
                        "tooltip": "The ID of the review comment to reply to. Replying to any comment in a thread appends to that thread."
                    },
                    "body": {
                        "type": "textarea",
                        "label": "Body",
                        "index": 4,
                        "tooltip": "The text of the reply. Markdown is supported."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "ID",
                        "example": 3966546621
                    },
                    "nodeId": {
                        "type": "string",
                        "title": "Node ID",
                        "example": "PRRC_kwDOK5R0o86ubJc9"
                    },
                    "body": {
                        "type": "string",
                        "title": "Body",
                        "example": "`since` is advanced after the API call, so a comment can be missed."
                    },
                    "htmlUrl": {
                        "type": "string",
                        "title": "HTML URL",
                        "example": "https://github.com/octocat/Hello-World/pull/1259#discussion_r3966546621"
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2026-09-09T09:01:23Z"
                    },
                    "updatedAt": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2026-09-09T09:01:24Z"
                    },
                    "pullRequestNumber": {
                        "type": "integer",
                        "title": "Pull Request Number",
                        "example": 1259
                    },
                    "pullRequestReviewId": {
                        "type": "integer",
                        "title": "Pull Request Review ID",
                        "example": 5152089066
                    },
                    "inReplyToId": {
                        "type": "integer",
                        "title": "In Reply To ID",
                        "example": 3966546487
                    },
                    "path": {
                        "type": "string",
                        "title": "Path",
                        "example": "src/appmixer/github/list/NewMention/NewMention.js"
                    },
                    "line": {
                        "type": "integer",
                        "title": "Line",
                        "example": 88
                    },
                    "startLine": {
                        "type": "integer",
                        "title": "Start Line",
                        "example": 84
                    },
                    "side": {
                        "type": "string",
                        "title": "Side",
                        "example": "RIGHT"
                    },
                    "subjectType": {
                        "type": "string",
                        "title": "Subject Type",
                        "example": "line"
                    },
                    "diffHunk": {
                        "type": "string",
                        "title": "Diff Hunk",
                        "example": "@@ -84,6 +84,8 @@ const nextSince = nowIso();"
                    },
                    "commitId": {
                        "type": "string",
                        "title": "Commit ID",
                        "example": "e80efb98eb3b79d523a0bbf51a062c85bda2840a"
                    },
                    "userLogin": {
                        "type": "string",
                        "title": "User Login",
                        "example": "Copilot"
                    },
                    "userId": {
                        "type": "integer",
                        "title": "User ID",
                        "example": 175728472
                    },
                    "userType": {
                        "type": "string",
                        "title": "User Type",
                        "example": "Bot"
                    },
                    "authorAssociation": {
                        "type": "string",
                        "title": "Author Association",
                        "example": "MEMBER"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
