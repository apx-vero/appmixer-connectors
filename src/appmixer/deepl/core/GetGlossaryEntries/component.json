{
    "name": "appmixer.deepl.core.GetGlossaryEntries",
    "label": "Get Glossary Entries",
    "description": "Get the entries of one dictionary (language pair) of a DeepL glossary, one entry per line with the source and the target term separated by a tab.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:deepl"
    },
    "quota": {
        "manager": "appmixer:deepl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "glossaryId": {
                        "type": "string"
                    },
                    "sourceLang": {
                        "type": "string"
                    },
                    "targetLang": {
                        "type": "string"
                    }
                },
                "required": [
                    "glossaryId",
                    "sourceLang",
                    "targetLang"
                ]
            },
            "inspector": {
                "inputs": {
                    "glossaryId": {
                        "type": "text",
                        "index": 1,
                        "label": "Glossary",
                        "tooltip": "Pick a glossary, or type the glossary ID.",
                        "source": {
                            "url": "/component/appmixer/deepl/core/ListGlossaries?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListGlossaries#toSelectArray"
                            }
                        }
                    },
                    "sourceLang": {
                        "type": "text",
                        "index": 2,
                        "label": "Source Language",
                        "tooltip": "The source language of the dictionary, for example <code>en</code>. Pick one, or type the code.",
                        "source": {
                            "url": "/component/appmixer/deepl/core/ListLanguages?outPort=out",
                            "data": {
                                "messages": {
                                    "in/resource": "glossary",
                                    "in/usableAs": "source"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListLanguages#toSelectArray"
                            }
                        }
                    },
                    "targetLang": {
                        "type": "text",
                        "index": 3,
                        "label": "Target Language",
                        "tooltip": "The target language of the dictionary, for example <code>de</code>. Pick one, or type the code.",
                        "source": {
                            "url": "/component/appmixer/deepl/core/ListLanguages?outPort=out",
                            "data": {
                                "messages": {
                                    "in/resource": "glossary",
                                    "in/usableAs": "target"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListLanguages#toSelectArray"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "source_lang",
                    "target_lang",
                    "entries"
                ],
                "properties": {
                    "source_lang": {
                        "type": "string",
                        "title": "Source Language",
                        "example": "en"
                    },
                    "target_lang": {
                        "type": "string",
                        "title": "Target Language",
                        "example": "de"
                    },
                    "entries": {
                        "type": "string",
                        "title": "Entries",
                        "example": "Hello\tHallo\nWorld\tWelt"
                    },
                    "entries_format": {
                        "type": "string",
                        "title": "Entries Format",
                        "example": "tsv"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
