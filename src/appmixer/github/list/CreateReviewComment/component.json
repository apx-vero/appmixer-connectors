{
    "name": "appmixer.github.list.CreateReviewComment",
    "label": "Create Review Comment",
    "description": "Add a review comment to a pull request, anchored to a line or to a whole file of the diff.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "public_repo",
            "repo"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "repositoryId": {
                        "type": "string",
                        "pattern": "[^/]+[/][^/]+"
                    },
                    "pullRequestNumber": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    },
                    "commitId": {
                        "type": "string"
                    },
                    "path": {
                        "type": "string"
                    },
                    "subjectType": {
                        "type": "string",
                        "enum": [
                            "line",
                            "file"
                        ]
                    },
                    "line": {
                        "type": "string"
                    },
                    "side": {
                        "type": "string",
                        "enum": [
                            "RIGHT",
                            "LEFT"
                        ]
                    },
                    "startLine": {
                        "type": "string"
                    },
                    "startSide": {
                        "type": "string",
                        "enum": [
                            "RIGHT",
                            "LEFT"
                        ]
                    }
                },
                "required": [
                    "repositoryId",
                    "pullRequestNumber",
                    "body",
                    "commitId",
                    "path"
                ]
            },
            "inspector": {
                "inputs": {
                    "repositoryId": {
                        "type": "text",
                        "group": "config",
                        "label": "Repository",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                            "data": {
                                "transform": "./transformers#reposToSelectArray"
                            }
                        },
                        "tooltip": "The repository the pull request lives in, in the 'owner/repo' form."
                    },
                    "pullRequestNumber": {
                        "type": "text",
                        "label": "Pull Request Number",
                        "index": 2,
                        "tooltip": "The number of the pull request to comment on."
                    },
                    "body": {
                        "type": "textarea",
                        "label": "Body",
                        "index": 3,
                        "tooltip": "The text of the comment. Markdown is supported."
                    },
                    "commitId": {
                        "type": "text",
                        "label": "Commit SHA",
                        "index": 4,
                        "tooltip": "The SHA of the commit to comment on. Use the head SHA of the pull request; GitHub rejects a comment whose commit is not part of the pull request."
                    },
                    "path": {
                        "type": "text",
                        "label": "File Path",
                        "index": 5,
                        "tooltip": "Path of the file to comment on, relative to the repository root."
                    },
                    "subjectType": {
                        "type": "select",
                        "label": "Comment On",
                        "index": 6,
                        "defaultValue": "line",
                        "tooltip": "Anchor the comment to a line of the diff, or to the file as a whole.",
                        "options": [
                            {
                                "label": "A line of the diff",
                                "value": "line"
                            },
                            {
                                "label": "The whole file",
                                "value": "file"
                            }
                        ]
                    },
                    "line": {
                        "type": "text",
                        "label": "Line",
                        "index": 7,
                        "tooltip": "The line of the file to comment on, as it appears in the diff. Required unless commenting on the whole file.",
                        "when": {
                            "eq": {
                                "./subjectType": "line"
                            }
                        }
                    },
                    "side": {
                        "type": "select",
                        "label": "Side",
                        "index": 8,
                        "defaultValue": "RIGHT",
                        "tooltip": "RIGHT is the version after the change, LEFT the version before it.",
                        "options": [
                            {
                                "label": "After the change (RIGHT)",
                                "value": "RIGHT"
                            },
                            {
                                "label": "Before the change (LEFT)",
                                "value": "LEFT"
                            }
                        ],
                        "when": {
                            "eq": {
                                "./subjectType": "line"
                            }
                        }
                    },
                    "startLine": {
                        "type": "text",
                        "label": "Start Line",
                        "index": 9,
                        "tooltip": "Optional. First line of a multi-line comment; Line is then the last line of the range.",
                        "when": {
                            "eq": {
                                "./subjectType": "line"
                            }
                        }
                    },
                    "startSide": {
                        "type": "select",
                        "label": "Start Side",
                        "index": 10,
                        "defaultValue": "RIGHT",
                        "tooltip": "Side of the range start, used together with Start Line.",
                        "options": [
                            {
                                "label": "After the change (RIGHT)",
                                "value": "RIGHT"
                            },
                            {
                                "label": "Before the change (LEFT)",
                                "value": "LEFT"
                            }
                        ],
                        "when": {
                            "eq": {
                                "./subjectType": "line"
                            }
                        }
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "ID",
                        "example": 3966546621
                    },
                    "nodeId": {
                        "type": "string",
                        "title": "Node ID",
                        "example": "PRRC_kwDOK5R0o86ubJc9"
                    },
                    "body": {
                        "type": "string",
                        "title": "Body",
                        "example": "`since` is advanced after the API call, so a comment can be missed."
                    },
                    "htmlUrl": {
                        "type": "string",
                        "title": "HTML URL",
                        "example": "https://github.com/octocat/Hello-World/pull/1259#discussion_r3966546621"
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2026-09-09T09:01:23Z"
                    },
                    "updatedAt": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2026-09-09T09:01:24Z"
                    },
                    "pullRequestNumber": {
                        "type": "integer",
                        "title": "Pull Request Number",
                        "example": 1259
                    },
                    "pullRequestReviewId": {
                        "type": "integer",
                        "title": "Pull Request Review ID",
                        "example": 5152089066
                    },
                    "inReplyToId": {
                        "type": "integer",
                        "title": "In Reply To ID",
                        "example": 3966546487
                    },
                    "path": {
                        "type": "string",
                        "title": "Path",
                        "example": "src/appmixer/github/list/NewMention/NewMention.js"
                    },
                    "line": {
                        "type": "integer",
                        "title": "Line",
                        "example": 88
                    },
                    "startLine": {
                        "type": "integer",
                        "title": "Start Line",
                        "example": 84
                    },
                    "side": {
                        "type": "string",
                        "title": "Side",
                        "example": "RIGHT"
                    },
                    "subjectType": {
                        "type": "string",
                        "title": "Subject Type",
                        "example": "line"
                    },
                    "diffHunk": {
                        "type": "string",
                        "title": "Diff Hunk",
                        "example": "@@ -84,6 +84,8 @@ const nextSince = nowIso();"
                    },
                    "commitId": {
                        "type": "string",
                        "title": "Commit ID",
                        "example": "e80efb98eb3b79d523a0bbf51a062c85bda2840a"
                    },
                    "userLogin": {
                        "type": "string",
                        "title": "User Login",
                        "example": "Copilot"
                    },
                    "userId": {
                        "type": "integer",
                        "title": "User ID",
                        "example": 175728472
                    },
                    "userType": {
                        "type": "string",
                        "title": "User Type",
                        "example": "Bot"
                    },
                    "authorAssociation": {
                        "type": "string",
                        "title": "Author Association",
                        "example": "MEMBER"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
