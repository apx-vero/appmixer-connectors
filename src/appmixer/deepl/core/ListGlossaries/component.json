{
    "name": "appmixer.deepl.core.ListGlossaries",
    "label": "List Glossaries",
    "description": "Glossaries of the account, as options of a glossary field.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": true,
    "auth": {
        "service": "appmixer:deepl"
    },
    "quota": {
        "manager": "appmixer:deepl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {}
            },
            "inspector": {
                "inputs": {}
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "glossaries": {
                        "type": "array",
                        "title": "Glossaries",
                        "items": {
                            "type": "object",
                            "properties": {
                                "glossary_id": {
                                    "type": "string",
                                    "title": "Glossary ID",
                                    "example": "def3a26b-3e84-45b3-84ae-0c0aaf3525f7"
                                },
                                "name": {
                                    "type": "string",
                                    "title": "Name",
                                    "example": "Product terms"
                                }
                            }
                        },
                        "example": [
                            {
                                "glossary_id": "def3a26b-3e84-45b3-84ae-0c0aaf3525f7",
                                "name": "Product terms"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
