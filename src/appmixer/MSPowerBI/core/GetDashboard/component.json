{
    "name": "appmixer.MSPowerBI.core.GetDashboard",
    "author": "Appmixer",
    "description": "Returns the specified dashboard from My Workspace or a specified group/workspace.",
    "private": false,
    "icon": "data:image/svg+xml;base64,",
    "auth": {
        "service": "appmixer:MSPowerBI",
        "scope": [
            "Dashboard.Read.All"
        ]
    },
    "quota": {
        "manager": "appmixer:MSPowerBI:core",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "dashboardId": {
                        "type": "string"
                    }
                },
                "required": [
                    "dashboardId"
                ]
            },
            "inspector": {
                "inputs": {
                    "dashboardId": {
                        "type": "text",
                        "group": "config",
                        "label": "Dashboard ID",
                        "index": 1,
                        "tooltip": "The ID of the dashboard to retrieve."
                    }
                },
                "groups": {
                    "config": {
                        "label": "Configuration",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Dashboard ID",
                    "value": "id"
                },
                {
                    "label": "Display Name",
                    "value": "displayName"
                },
                {
                    "label": "Is Read Only",
                    "value": "isReadOnly"
                },
                {
                    "label": "Embed URL",
                    "value": "embedUrl"
                },
                {
                    "label": "Web URL",
                    "value": "webUrl"
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "groupId": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "groupId": {
                    "type": "text",
                    "group": "config",
                    "label": "Workspace (Group) ID",
                    "index": 2,
                    "tooltip": "Optional. The workspace (group) ID. If omitted, My Workspace is used.",
                    "required": false
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}