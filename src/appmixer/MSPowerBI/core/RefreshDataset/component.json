{
    "name": "appmixer.MSPowerBI.core.RefreshDataset",
    "author": "Appmixer",
    "description": "Triggers a refresh for the specified dataset. Only available for datasets in import/DirectQuery mode.",
    "private": false,
    "icon": "data:image/svg+xml;base64,",
    "auth": {
        "service": "appmixer:MSPowerBI",
        "scope": [
            "Dataset.ReadWrite.All"
        ]
    },
    "quota": {
        "manager": "appmixer:MSPowerBI:core",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "datasetId": {
                        "type": "string"
                    },
                    "notifyOption": {
                        "type": "string"
                    }
                },
                "required": [
                    "datasetId"
                ]
            },
            "inspector": {
                "inputs": {
                    "datasetId": {
                        "type": "text",
                        "group": "config",
                        "label": "Dataset ID",
                        "index": 1,
                        "tooltip": "The ID of the dataset to refresh."
                    },
                    "notifyOption": {
                        "type": "select",
                        "group": "config",
                        "label": "Notify Option",
                        "index": 2,
                        "tooltip": "Notification option to set after refresh completes.",
                        "options": [
                            {
                                "label": "No Notification",
                                "value": "NoNotification"
                            },
                            {
                                "label": "Mail On Failure",
                                "value": "MailOnFailure"
                            },
                            {
                                "label": "Mail On Completion",
                                "value": "MailOnCompletion"
                            }
                        ],
                        "required": false
                    }
                },
                "groups": {
                    "config": {
                        "label": "Configuration",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Status",
                    "value": "status"
                },
                {
                    "label": "Dataset ID",
                    "value": "datasetId"
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "groupId": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "groupId": {
                    "type": "text",
                    "group": "config",
                    "label": "Workspace (Group) ID",
                    "index": 3,
                    "tooltip": "Optional. The workspace (group) ID. If omitted, My Workspace is used.",
                    "required": false
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}