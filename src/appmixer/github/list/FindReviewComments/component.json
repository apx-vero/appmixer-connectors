{
    "name": "appmixer.github.list.FindReviewComments",
    "label": "Find Review Comments",
    "description": "Find review comments in a repository, optionally narrowed to one pull request, to an author or to comments updated since a given time.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "public_repo",
            "repo"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "repositoryId": {
                        "type": "string",
                        "pattern": "[^/]+[/][^/]+"
                    },
                    "pullRequestNumber": {
                        "type": "string"
                    },
                    "author": {
                        "type": "string"
                    },
                    "since": {
                        "type": "string"
                    },
                    "outputType": {
                        "type": "string",
                        "enum": [
                            "array",
                            "first",
                            "object",
                            "file"
                        ]
                    }
                },
                "required": [
                    "repositoryId"
                ]
            },
            "inspector": {
                "inputs": {
                    "repositoryId": {
                        "type": "text",
                        "group": "config",
                        "label": "Repository",
                        "index": 1,
                        "source": {
                            "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                            "data": {
                                "transform": "./transformers#reposToSelectArray"
                            }
                        },
                        "tooltip": "The repository to search, in the 'owner/repo' form."
                    },
                    "pullRequestNumber": {
                        "type": "text",
                        "label": "Pull Request Number",
                        "index": 2,
                        "tooltip": "Optional. Restrict the search to one pull request. Leave empty to search the whole repository."
                    },
                    "author": {
                        "type": "text",
                        "label": "Author",
                        "index": 3,
                        "tooltip": "Optional. Only emit items written by this login. The comparison is case-insensitive, ignores a trailing <code>[bot]</code> and accepts a prefix, because GitHub reports the same account under different logins depending on the endpoint — Copilot's reviewer is <code>Copilot</code> on review comments, <code>copilot-pull-request-reviewer[bot]</code> on reviews and <code>copilot-pull-request-reviewer</code> in GraphQL. Entering <code>copilot</code> matches all three."
                    },
                    "since": {
                        "type": "date-time",
                        "label": "Updated Since",
                        "index": 4,
                        "tooltip": "Optional. Only comments last updated after this time. Applies to the whole-repository search only."
                    },
                    "outputType": {
                        "type": "select",
                        "label": "Output Type",
                        "index": 5,
                        "defaultValue": "array",
                        "tooltip": "Choose whether you want to receive the result set as one complete list, or first item only or one item at a time or stream the items to a file.",
                        "options": [
                            {
                                "label": "First Item Only",
                                "value": "first"
                            },
                            {
                                "label": "All items at once",
                                "value": "array"
                            },
                            {
                                "label": "One item at a time",
                                "value": "object"
                            },
                            {
                                "label": "Store to CSV file",
                                "value": "file"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "source": {
                "url": "/component/appmixer/github/list/FindReviewComments?outPort=out&ignoreAuth=true",
                "data": {
                    "properties": {
                        "generateOutputPortOptions": true
                    },
                    "messages": {
                        "in/outputType": "inputs/in/outputType",
                        "in/repositoryId": "dummy/dummy"
                    }
                }
            }
        },
        {
            "name": "notFound",
            "schema": {
                "type": "object",
                "properties": {}
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
