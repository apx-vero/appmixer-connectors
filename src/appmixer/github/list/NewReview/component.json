{
    "name": "appmixer.github.list.NewReview",
    "label": "New Review",
    "description": "Triggers when a review is submitted on an open pull request in the selected repository, including an approval or a review that carries only a summary and no inline comments.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "public_repo",
            "repo"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "properties": {
                "repositoryId": {
                    "type": "string",
                    "pattern": "[^/]+[/][^/]+"
                },
                "state": {
                    "type": "string",
                    "enum": [
                        "any",
                        "APPROVED",
                        "CHANGES_REQUESTED",
                        "COMMENTED",
                        "DISMISSED"
                    ]
                },
                "maxPullRequests": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                },
                "author": {
                    "type": "string"
                },
                "authorType": {
                    "type": "string",
                    "enum": [
                        "any",
                        "user",
                        "bot"
                    ]
                }
            },
            "required": [
                "repositoryId"
            ]
        },
        "inspector": {
            "inputs": {
                "repositoryId": {
                    "type": "text",
                    "group": "config",
                    "label": "Repository",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                        "data": {
                            "transform": "./transformers#reposToSelectArray"
                        }
                    },
                    "tooltip": "The repository whose pull requests to watch, in the 'owner/repo' form."
                },
                "state": {
                    "type": "select",
                    "group": "config",
                    "label": "State",
                    "index": 2,
                    "defaultValue": "any",
                    "tooltip": "Only emit reviews submitted in this state.",
                    "options": [
                        {
                            "label": "Any",
                            "value": "any"
                        },
                        {
                            "label": "Approved",
                            "value": "APPROVED"
                        },
                        {
                            "label": "Changes requested",
                            "value": "CHANGES_REQUESTED"
                        },
                        {
                            "label": "Commented",
                            "value": "COMMENTED"
                        },
                        {
                            "label": "Dismissed",
                            "value": "DISMISSED"
                        }
                    ]
                },
                "maxPullRequests": {
                    "type": "number",
                    "group": "config",
                    "label": "Pull Requests To Scan",
                    "index": 3,
                    "defaultValue": 20,
                    "min": 1,
                    "max": 100,
                    "tooltip": "GitHub has no repository-wide reviews endpoint, so each tick reads the reviews of this many most recently updated open pull requests. Raise it for busy repositories, at the cost of one API call per pull request."
                },
                "author": {
                    "type": "text",
                    "label": "Author",
                    "index": 4,
                    "tooltip": "Optional. Only emit items written by this login. The comparison is case-insensitive, ignores a trailing <code>[bot]</code> and accepts a prefix, because GitHub reports the same account under different logins depending on the endpoint — Copilot's reviewer is <code>Copilot</code> on review comments, <code>copilot-pull-request-reviewer[bot]</code> on reviews and <code>copilot-pull-request-reviewer</code> in GraphQL. Entering <code>copilot</code> matches all three.",
                    "group": "config"
                },
                "authorType": {
                    "type": "select",
                    "label": "Author Type",
                    "index": 5,
                    "defaultValue": "any",
                    "tooltip": "Restrict to comments written by people, by bots, or by anyone.",
                    "options": [
                        {
                            "label": "Anyone",
                            "value": "any"
                        },
                        {
                            "label": "People only",
                            "value": "user"
                        },
                        {
                            "label": "Bots only",
                            "value": "bot"
                        }
                    ],
                    "group": "config"
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "ID",
                        "example": 5152089066
                    },
                    "nodeId": {
                        "type": "string",
                        "title": "Node ID",
                        "example": "PRR_kwDOK5R0o86gk_Y1"
                    },
                    "state": {
                        "type": "string",
                        "title": "State",
                        "example": "CHANGES_REQUESTED"
                    },
                    "body": {
                        "type": "string",
                        "title": "Body",
                        "example": "A few issues worth fixing before merge."
                    },
                    "htmlUrl": {
                        "type": "string",
                        "title": "HTML URL",
                        "example": "https://github.com/octocat/Hello-World/pull/1259#pullrequestreview-5152089066"
                    },
                    "submittedAt": {
                        "type": "string",
                        "title": "Submitted At",
                        "example": "2026-09-09T09:01:23Z"
                    },
                    "commitId": {
                        "type": "string",
                        "title": "Commit ID",
                        "example": "e80efb98eb3b79d523a0bbf51a062c85bda2840a"
                    },
                    "pullRequestNumber": {
                        "type": "integer",
                        "title": "Pull Request Number",
                        "example": 1259
                    },
                    "userLogin": {
                        "type": "string",
                        "title": "User Login",
                        "example": "Copilot"
                    },
                    "userId": {
                        "type": "integer",
                        "title": "User ID",
                        "example": 175728472
                    },
                    "userType": {
                        "type": "string",
                        "title": "User Type",
                        "example": "Bot"
                    },
                    "authorAssociation": {
                        "type": "string",
                        "title": "Author Association",
                        "example": "MEMBER"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
