{
    "name": "appmixer.deepl.core.TranslateText",
    "label": "Translate Text",
    "description": "Translate a text into another language with DeepL. The source language is detected when you leave it empty.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:deepl"
    },
    "quota": {
        "manager": "appmixer:deepl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "text": {
                        "type": "string"
                    },
                    "targetLang": {
                        "type": "string"
                    },
                    "sourceLang": {
                        "type": "string"
                    },
                    "formality": {
                        "type": "string",
                        "enum": [
                            "default",
                            "more",
                            "less",
                            "prefer_more",
                            "prefer_less"
                        ]
                    },
                    "glossaryId": {
                        "type": "string"
                    },
                    "context": {
                        "type": "string"
                    },
                    "modelType": {
                        "type": "string",
                        "enum": [
                            "quality_optimized",
                            "prefer_quality_optimized",
                            "latency_optimized"
                        ]
                    },
                    "tagHandling": {
                        "type": "string",
                        "enum": [
                            "xml",
                            "html"
                        ]
                    },
                    "preserveFormatting": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "text",
                    "targetLang"
                ]
            },
            "inspector": {
                "inputs": {
                    "text": {
                        "type": "textarea",
                        "index": 1,
                        "label": "Text",
                        "tooltip": "The text to translate (plain UTF-8 text, or XML/HTML with Tag Handling)."
                    },
                    "targetLang": {
                        "type": "text",
                        "index": 2,
                        "label": "Target Language",
                        "tooltip": "The language to translate into, for example <code>DE</code> or <code>EN-US</code>. Pick one, or type the code.",
                        "source": {
                            "url": "/component/appmixer/deepl/core/ListLanguages?outPort=out",
                            "data": {
                                "messages": {
                                    "in/resource": "translate_text",
                                    "in/usableAs": "target"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListLanguages#toSelectArray"
                            }
                        }
                    },
                    "sourceLang": {
                        "type": "text",
                        "index": 3,
                        "label": "Source Language",
                        "tooltip": "The language of the text, for example <code>EN</code>. Leave empty to detect it. Required when you use a glossary.",
                        "source": {
                            "url": "/component/appmixer/deepl/core/ListLanguages?outPort=out",
                            "data": {
                                "messages": {
                                    "in/resource": "translate_text",
                                    "in/usableAs": "source"
                                },
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListLanguages#toSelectArray"
                            }
                        }
                    },
                    "formality": {
                        "type": "select",
                        "index": 4,
                        "label": "Formality",
                        "tooltip": "Lean towards formal or informal language. Only some target languages support it; the \"if available\" options fall back to the default elsewhere.",
                        "options": [
                            {
                                "label": "Default",
                                "value": "default"
                            },
                            {
                                "label": "More formal",
                                "value": "more"
                            },
                            {
                                "label": "Less formal",
                                "value": "less"
                            },
                            {
                                "label": "More formal if available",
                                "value": "prefer_more"
                            },
                            {
                                "label": "Less formal if available",
                                "value": "prefer_less"
                            }
                        ]
                    },
                    "glossaryId": {
                        "type": "text",
                        "index": 5,
                        "label": "Glossary",
                        "tooltip": "A glossary to apply. It needs a dictionary for the language pair, and the Source Language must be set. Pick one, or type the glossary ID.",
                        "source": {
                            "url": "/component/appmixer/deepl/core/ListGlossaries?outPort=out",
                            "data": {
                                "properties": {
                                    "isSource": true
                                },
                                "transform": "./ListGlossaries#toSelectArray"
                            }
                        }
                    },
                    "context": {
                        "type": "textarea",
                        "index": 6,
                        "label": "Context",
                        "tooltip": "Additional text that helps DeepL translate, for example the paragraph around the text. It is not translated and not billed."
                    },
                    "modelType": {
                        "type": "select",
                        "index": 7,
                        "label": "Model Type",
                        "tooltip": "Which DeepL model to use. Leave empty for DeepL's default.",
                        "options": [
                            {
                                "label": "Quality optimized",
                                "value": "quality_optimized"
                            },
                            {
                                "label": "Prefer quality optimized",
                                "value": "prefer_quality_optimized"
                            },
                            {
                                "label": "Latency optimized",
                                "value": "latency_optimized"
                            }
                        ]
                    },
                    "tagHandling": {
                        "type": "select",
                        "index": 8,
                        "label": "Tag Handling",
                        "tooltip": "Translate XML or HTML and keep its tags. Leave empty for plain text.",
                        "options": [
                            {
                                "label": "XML",
                                "value": "xml"
                            },
                            {
                                "label": "HTML",
                                "value": "html"
                            }
                        ]
                    },
                    "preserveFormatting": {
                        "type": "toggle",
                        "index": 9,
                        "label": "Preserve Formatting",
                        "defaultValue": false,
                        "tooltip": "Keep the original formatting (punctuation, upper and lower case at the start of a sentence) even where DeepL would correct it."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "text",
                    "detected_source_language"
                ],
                "properties": {
                    "text": {
                        "type": "string",
                        "title": "Translated Text",
                        "example": "Hallo, Welt!"
                    },
                    "detected_source_language": {
                        "type": "string",
                        "title": "Detected Source Language",
                        "example": "EN"
                    },
                    "billed_characters": {
                        "type": "integer",
                        "title": "Billed Characters",
                        "example": 13
                    },
                    "model_type_used": {
                        "type": "string",
                        "title": "Model Type Used",
                        "example": "quality_optimized"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
