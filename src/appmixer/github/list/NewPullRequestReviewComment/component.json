{
    "name": "appmixer.github.list.NewPullRequestReviewComment",
    "label": "New Pull Request Review Comment",
    "description": "Triggers when a new review comment is left on a pull request in the selected repository. These are the comments anchored to a line of the diff, not the pull request conversation — for those use New Issue Comment.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "private": false,
    "tick": true,
    "auth": {
        "service": "appmixer:github",
        "scope": [
            "public_repo",
            "repo"
        ]
    },
    "quota": {
        "manager": "appmixer:github",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "properties": {
        "schema": {
            "properties": {
                "repositoryId": {
                    "type": "string",
                    "pattern": "[^/]+[/][^/]+"
                },
                "pullRequestNumber": {
                    "type": "string"
                },
                "author": {
                    "type": "string"
                },
                "authorType": {
                    "type": "string",
                    "enum": [
                        "any",
                        "user",
                        "bot"
                    ]
                }
            },
            "required": [
                "repositoryId"
            ]
        },
        "inspector": {
            "inputs": {
                "repositoryId": {
                    "type": "text",
                    "group": "config",
                    "label": "Repository",
                    "index": 1,
                    "source": {
                        "url": "/component/appmixer/github/list/ListRepos?outPort=repositories",
                        "data": {
                            "transform": "./transformers#reposToSelectArray"
                        }
                    },
                    "tooltip": "The repository whose pull requests to watch, in the 'owner/repo' form."
                },
                "pullRequestNumber": {
                    "type": "text",
                    "group": "config",
                    "label": "Pull Request Number",
                    "index": 2,
                    "tooltip": "Optional. Watch only this pull request. Leave empty to watch every pull request in the repository."
                },
                "author": {
                    "type": "text",
                    "label": "Author",
                    "index": 3,
                    "tooltip": "Optional. Only emit items written by this login. The comparison is case-insensitive, ignores a trailing <code>[bot]</code> and accepts a prefix, because GitHub reports the same account under different logins depending on the endpoint — Copilot's reviewer is <code>Copilot</code> on review comments, <code>copilot-pull-request-reviewer[bot]</code> on reviews and <code>copilot-pull-request-reviewer</code> in GraphQL. Entering <code>copilot</code> matches all three.",
                    "group": "config"
                },
                "authorType": {
                    "type": "select",
                    "label": "Author Type",
                    "index": 4,
                    "defaultValue": "any",
                    "tooltip": "Restrict to comments written by people, by bots, or by anyone.",
                    "options": [
                        {
                            "label": "Anyone",
                            "value": "any"
                        },
                        {
                            "label": "People only",
                            "value": "user"
                        },
                        {
                            "label": "Bots only",
                            "value": "bot"
                        }
                    ],
                    "group": "config"
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    },
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "ID",
                        "example": 3966546621
                    },
                    "nodeId": {
                        "type": "string",
                        "title": "Node ID",
                        "example": "PRRC_kwDOK5R0o86ubJc9"
                    },
                    "body": {
                        "type": "string",
                        "title": "Body",
                        "example": "`since` is advanced after the API call, so a comment can be missed."
                    },
                    "htmlUrl": {
                        "type": "string",
                        "title": "HTML URL",
                        "example": "https://github.com/octocat/Hello-World/pull/1259#discussion_r3966546621"
                    },
                    "createdAt": {
                        "type": "string",
                        "title": "Created At",
                        "example": "2026-09-09T09:01:23Z"
                    },
                    "updatedAt": {
                        "type": "string",
                        "title": "Updated At",
                        "example": "2026-09-09T09:01:24Z"
                    },
                    "pullRequestNumber": {
                        "type": "integer",
                        "title": "Pull Request Number",
                        "example": 1259
                    },
                    "pullRequestReviewId": {
                        "type": "integer",
                        "title": "Pull Request Review ID",
                        "example": 5152089066
                    },
                    "inReplyToId": {
                        "type": "integer",
                        "title": "In Reply To ID",
                        "example": 3966546487
                    },
                    "path": {
                        "type": "string",
                        "title": "Path",
                        "example": "src/appmixer/github/list/NewMention/NewMention.js"
                    },
                    "line": {
                        "type": "integer",
                        "title": "Line",
                        "example": 88
                    },
                    "startLine": {
                        "type": "integer",
                        "title": "Start Line",
                        "example": 84
                    },
                    "side": {
                        "type": "string",
                        "title": "Side",
                        "example": "RIGHT"
                    },
                    "subjectType": {
                        "type": "string",
                        "title": "Subject Type",
                        "example": "line"
                    },
                    "diffHunk": {
                        "type": "string",
                        "title": "Diff Hunk",
                        "example": "@@ -84,6 +84,8 @@ const nextSince = nowIso();"
                    },
                    "commitId": {
                        "type": "string",
                        "title": "Commit ID",
                        "example": "e80efb98eb3b79d523a0bbf51a062c85bda2840a"
                    },
                    "userLogin": {
                        "type": "string",
                        "title": "User Login",
                        "example": "Copilot"
                    },
                    "userId": {
                        "type": "integer",
                        "title": "User ID",
                        "example": 175728472
                    },
                    "userType": {
                        "type": "string",
                        "title": "User Type",
                        "example": "Bot"
                    },
                    "authorAssociation": {
                        "type": "string",
                        "title": "Author Association",
                        "example": "MEMBER"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
