{
    "name": "appmixer.MSPowerBI.core.GetRefreshHistory",
    "author": "Appmixer",
    "description": "Returns the refresh history for the specified dataset.",
    "private": false,
    "icon": "data:image/svg+xml;base64,",
    "auth": {
        "service": "appmixer:MSPowerBI",
        "scope": [
            "Dataset.Read.All"
        ]
    },
    "quota": {
        "manager": "appmixer:MSPowerBI:core",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "datasetId": {
                        "type": "string"
                    },
                    "top": {
                        "type": "number"
                    }
                },
                "required": [
                    "datasetId"
                ]
            },
            "inspector": {
                "inputs": {
                    "datasetId": {
                        "type": "text",
                        "group": "config",
                        "label": "Dataset ID",
                        "index": 1,
                        "tooltip": "The ID of the dataset whose refresh history to retrieve."
                    },
                    "top": {
                        "type": "number",
                        "group": "config",
                        "label": "Top (Limit)",
                        "index": 2,
                        "tooltip": "Optional. The number of most recent refresh history entries to return.",
                        "required": false
                    }
                },
                "groups": {
                    "config": {
                        "label": "Configuration",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Refresh History",
                    "value": "refreshHistory"
                },
                {
                    "label": "Count",
                    "value": "count"
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "groupId": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "groupId": {
                    "type": "text",
                    "group": "config",
                    "label": "Workspace (Group) ID",
                    "index": 3,
                    "tooltip": "Optional. The workspace (group) ID. If omitted, My Workspace is used.",
                    "required": false
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}