{
    "name": "appmixer.deepl.core.GetUsage",
    "label": "Get Usage",
    "description": "Get the usage and the limits of the DeepL account in the current billing period: translated characters, and documents where the plan limits them.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:deepl"
    },
    "quota": {
        "manager": "appmixer:deepl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in"
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "character_count",
                    "character_limit"
                ],
                "properties": {
                    "character_count": {
                        "type": "integer",
                        "title": "Character Count",
                        "example": 180118
                    },
                    "character_limit": {
                        "type": "integer",
                        "title": "Character Limit",
                        "example": 500000
                    },
                    "document_count": {
                        "type": "integer",
                        "title": "Document Count",
                        "example": 3
                    },
                    "document_limit": {
                        "type": "integer",
                        "title": "Document Limit",
                        "example": 10
                    },
                    "team_document_count": {
                        "type": "integer",
                        "title": "Team Document Count",
                        "example": 12
                    },
                    "team_document_limit": {
                        "type": "integer",
                        "title": "Team Document Limit",
                        "example": 100
                    },
                    "api_key_character_count": {
                        "type": "integer",
                        "title": "API Key Character Count",
                        "example": 636
                    },
                    "api_key_character_limit": {
                        "type": "integer",
                        "title": "API Key Character Limit",
                        "example": 1000000
                    },
                    "start_time": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Billing Period Start",
                        "example": "2026-11-13T09:18:42Z"
                    },
                    "end_time": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Billing Period End",
                        "example": "2026-12-13T09:18:42Z"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
