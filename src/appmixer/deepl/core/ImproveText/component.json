{
    "name": "appmixer.deepl.core.ImproveText",
    "label": "Improve Text",
    "description": "Rephrase a text with DeepL Write to fix spelling and grammar and improve its style, optionally in a writing style or a tone. Set either a writing style or a tone, not both.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:deepl"
    },
    "quota": {
        "manager": "appmixer:deepl",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "text": {
                        "type": "string"
                    },
                    "targetLang": {
                        "type": "string",
                        "enum": [
                            "de",
                            "en-GB",
                            "en-US",
                            "es",
                            "fr",
                            "it",
                            "ja",
                            "ko",
                            "pt-BR",
                            "pt-PT",
                            "zh-Hans"
                        ]
                    },
                    "writingStyle": {
                        "type": "string"
                    },
                    "tone": {
                        "type": "string"
                    }
                },
                "required": [
                    "text"
                ]
            },
            "inspector": {
                "inputs": {
                    "text": {
                        "type": "textarea",
                        "index": 1,
                        "label": "Text",
                        "tooltip": "The text to improve."
                    },
                    "targetLang": {
                        "type": "select",
                        "index": 2,
                        "label": "Language",
                        "tooltip": "The language of the improved text. Leave empty to keep the language of the text. A different language translates the text first.",
                        "options": [
                            {
                                "label": "German",
                                "value": "de"
                            },
                            {
                                "label": "English (British)",
                                "value": "en-GB"
                            },
                            {
                                "label": "English (American)",
                                "value": "en-US"
                            },
                            {
                                "label": "Spanish",
                                "value": "es"
                            },
                            {
                                "label": "French",
                                "value": "fr"
                            },
                            {
                                "label": "Italian",
                                "value": "it"
                            },
                            {
                                "label": "Japanese",
                                "value": "ja"
                            },
                            {
                                "label": "Korean",
                                "value": "ko"
                            },
                            {
                                "label": "Portuguese (Brazilian)",
                                "value": "pt-BR"
                            },
                            {
                                "label": "Portuguese (European)",
                                "value": "pt-PT"
                            },
                            {
                                "label": "Chinese (simplified)",
                                "value": "zh-Hans"
                            }
                        ]
                    },
                    "writingStyle": {
                        "type": "select",
                        "index": 3,
                        "label": "Writing Style",
                        "tooltip": "Rewrite the text for an audience. The \"if available\" options fall back to the default style for languages without styles.",
                        "options": [
                            {
                                "label": "Academic",
                                "value": "academic"
                            },
                            {
                                "label": "Business",
                                "value": "business"
                            },
                            {
                                "label": "Casual",
                                "value": "casual"
                            },
                            {
                                "label": "Simple",
                                "value": "simple"
                            },
                            {
                                "label": "Academic if available",
                                "value": "prefer_academic"
                            },
                            {
                                "label": "Business if available",
                                "value": "prefer_business"
                            },
                            {
                                "label": "Casual if available",
                                "value": "prefer_casual"
                            },
                            {
                                "label": "Simple if available",
                                "value": "prefer_simple"
                            }
                        ]
                    },
                    "tone": {
                        "type": "select",
                        "index": 4,
                        "label": "Tone",
                        "tooltip": "Rewrite the text in a tone. The \"if available\" options fall back to the default tone for languages without tones.",
                        "options": [
                            {
                                "label": "Confident",
                                "value": "confident"
                            },
                            {
                                "label": "Diplomatic",
                                "value": "diplomatic"
                            },
                            {
                                "label": "Enthusiastic",
                                "value": "enthusiastic"
                            },
                            {
                                "label": "Friendly",
                                "value": "friendly"
                            },
                            {
                                "label": "Confident if available",
                                "value": "prefer_confident"
                            },
                            {
                                "label": "Diplomatic if available",
                                "value": "prefer_diplomatic"
                            },
                            {
                                "label": "Enthusiastic if available",
                                "value": "prefer_enthusiastic"
                            },
                            {
                                "label": "Friendly if available",
                                "value": "prefer_friendly"
                            }
                        ]
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "schema": {
                "type": "object",
                "required": [
                    "text"
                ],
                "properties": {
                    "text": {
                        "type": "string",
                        "title": "Improved Text",
                        "example": "This is a sample sentence to improve."
                    },
                    "detected_source_language": {
                        "type": "string",
                        "title": "Detected Source Language",
                        "example": "en"
                    },
                    "target_language": {
                        "type": "string",
                        "title": "Target Language",
                        "example": "en-US"
                    }
                }
            }
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
