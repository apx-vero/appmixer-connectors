{
    "name": "appmixer.MSPowerBI.core.ExportReport",
    "author": "Appmixer",
    "description": "Exports the specified report to a file (PDF, PPTX, PNG, etc.) from My Workspace or a specified group/workspace.",
    "private": false,
    "icon": "data:image/svg+xml;base64,",
    "auth": {
        "service": "appmixer:MSPowerBI",
        "scope": [
            "Report.Read.All"
        ]
    },
    "quota": {
        "manager": "appmixer:MSPowerBI:core",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "reportId": {
                        "type": "string"
                    },
                    "format": {
                        "type": "string",
                        "enum": [
                            "PDF",
                            "PPTX",
                            "PNG",
                            "XLSX",
                            "DOCX",
                            "CSV",
                            "XML",
                            "MHTML"
                        ]
                    }
                },
                "required": [
                    "reportId",
                    "format"
                ]
            },
            "inspector": {
                "inputs": {
                    "reportId": {
                        "type": "text",
                        "group": "config",
                        "label": "Report ID",
                        "index": 1,
                        "tooltip": "The ID of the report to export."
                    },
                    "format": {
                        "type": "select",
                        "group": "config",
                        "label": "Export Format",
                        "index": 2,
                        "tooltip": "The format to export the report to.",
                        "options": [
                            {
                                "label": "PDF",
                                "value": "PDF"
                            },
                            {
                                "label": "PPTX",
                                "value": "PPTX"
                            },
                            {
                                "label": "PNG",
                                "value": "PNG"
                            },
                            {
                                "label": "XLSX",
                                "value": "XLSX"
                            },
                            {
                                "label": "DOCX",
                                "value": "DOCX"
                            },
                            {
                                "label": "CSV",
                                "value": "CSV"
                            },
                            {
                                "label": "XML",
                                "value": "XML"
                            },
                            {
                                "label": "MHTML",
                                "value": "MHTML"
                            }
                        ]
                    }
                },
                "groups": {
                    "config": {
                        "label": "Configuration",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Export ID",
                    "value": "id"
                },
                {
                    "label": "Status",
                    "value": "status"
                },
                {
                    "label": "Created Date",
                    "value": "createdDateTime"
                },
                {
                    "label": "Last Action Date",
                    "value": "lastActionDateTime"
                },
                {
                    "label": "Report ID",
                    "value": "reportId"
                },
                {
                    "label": "Report Name",
                    "value": "reportName"
                },
                {
                    "label": "Percent Complete",
                    "value": "percentComplete"
                },
                {
                    "label": "Resource Location",
                    "value": "resourceLocation"
                },
                {
                    "label": "Resource File Extension",
                    "value": "resourceFileExtension"
                }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "groupId": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "groupId": {
                    "type": "text",
                    "group": "config",
                    "label": "Workspace (Group) ID",
                    "index": 3,
                    "tooltip": "Optional. The workspace (group) ID. If omitted, My Workspace is used.",
                    "required": false
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}