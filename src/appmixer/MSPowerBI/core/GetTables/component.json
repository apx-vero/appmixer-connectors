{
    "name": "appmixer.MSPowerBI.core.GetTables",
    "author": "Appmixer",
    "description": "Returns a list of tables within the specified push dataset.",
    "private": false,
    "icon": "data:image/svg+xml;base64,",
    "auth": {
        "service": "appmixer:MSPowerBI"
    },
    "quota": {
        "manager": "appmixer:MSPowerBI:core",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "datasetId": {
                        "type": "string"
                    }
                },
                "required": ["datasetId"]
            },
            "inspector": {
                "inputs": {
                    "datasetId": {
                        "type": "text",
                        "group": "config",
                        "label": "Dataset ID",
                        "index": 1,
                        "tooltip": "The ID of the push dataset whose tables to retrieve."
                    }
                },
                "groups": {
                    "config": {
                        "label": "Configuration",
                        "index": 1
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Tables", "value": "tables" },
                { "label": "Table Count", "value": "count" }
            ]
        }
    ],
    "properties": {
        "schema": {
            "properties": {
                "groupId": {
                    "type": "string"
                }
            }
        },
        "inspector": {
            "inputs": {
                "groupId": {
                    "type": "text",
                    "group": "config",
                    "label": "Workspace (Group) ID",
                    "index": 2,
                    "tooltip": "Optional. The workspace (group) ID. If omitted, My Workspace is used.",
                    "required": false
                }
            },
            "groups": {
                "config": {
                    "label": "Configuration",
                    "index": 1
                }
            }
        }
    }
}
